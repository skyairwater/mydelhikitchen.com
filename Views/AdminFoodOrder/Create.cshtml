@model EcommerceStore.Models.FoodOrderViewModel

@{
    ViewData["Title"] = "Create Food Order";
}

<div class="row mt-4 mb-5 pb-5">
    <div class="col-md-8 offset-md-2">
        <h2 class="mb-4">Create Food Order</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="DeliveryDate" class="form-label fw-bold"></label>
                        <input asp-for="DeliveryDate" type="text" id="datepicker" class="form-control" autocomplete="off" />
                        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Menu" class="form-label fw-bold"></label>
                        <textarea asp-for="Menu" id="menuEditor" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Menu" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DeliveryCharge" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="DeliveryCharge" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="DeliveryCharge" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Comments" class="form-label fw-bold"></label>
                        <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Comments" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxOrders" class="form-label fw-bold"></label>
                        <input asp-for="MaxOrders" class="form-control" type="number" min="1" placeholder="Left blank for unlimited orders" />
                        <span asp-validation-for="MaxOrders" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Photos" class="form-label fw-bold"></label>
                        <input asp-for="Photos" type="file" multiple accept="image/*" class="form-control" id="photoUpload" />
                        <span asp-validation-for="Photos" class="text-danger"></span>
                        <small class="text-muted d-block mt-1">Upload up to 10 photos. Images will be automatically resized to a maximum of 300x300 pixels.</small>
                    </div>

                    <hr class="my-4" />
                    <h4 class="mb-3">Food Items</h4>
                    <table class="table table-bordered align-middle" id="foodItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Food Name (Max 500 characters)</th>
                                <th style="width: 200px;">Price</th>
                                <th style="width: 70px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input asp-for="Items[i].Name" class="form-control" maxlength="500" placeholder="Enter food name" />
                                        <span asp-validation-for="Items[i].Name" class="text-danger d-block mt-1"></span>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="Items[i].Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="Items[i].Price" class="text-danger d-block mt-1"></span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-success btn-sm add-row" title="Add Row">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Publish Food Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery UI for Datepicker -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <!-- TinyMCE Rich Text Editor -->
    <script src="https://cdn.tiny.cloud/1/740hbd15q9g9dmnqf0zkorvvco19h1r2276dsldo8t01ha5i/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        $(document).ready(function () {
            // Initialize jQuery UI Datepicker
            $("#datepicker").datepicker({
                minDate: 0, // Today or greater
                dateFormat: 'yy-mm-dd'
            });

            // Initialize TinyMCE
            tinymce.init({
                selector: '#menuEditor',
                plugins: 'lists link image preview',
                toolbar: 'undo redo | styles | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image | preview',
                menubar: false,
                statusbar: false,
                height: 300,
                // Because we are using bootstrap theme handling, we can conditionally load dark mode
                skin: localStorage.getItem('theme') === 'dark' ? 'oxide-dark' : 'oxide',
                content_css: localStorage.getItem('theme') === 'dark' ? 'dark' : 'default'
            });

            // Allow jQuery validation to handle date correctly in combination with datepicker
            $.validator.methods.date = function (value, element) {
                return this.optional(element) || !/Invalid|NaN/.test(new Date(value).toString());
            };

            // Dynamic Row Addition
            $(document).on('click', '.add-row', function () {
                var $tbody = $('#foodItemsTable tbody');
                var $lastRow = $tbody.find('tr:last');
                var $newRow = $lastRow.clone();
                var rowIndex = $tbody.find('tr').length;

                // Update input names and ids
                $newRow.find('input').each(function () {
                    var name = $(this).attr('name');
                    if (name) {
                        name = name.replace(/\[\d+\]/, '[' + rowIndex + ']');
                        $(this).attr('name', name);
                    }
                    var id = $(this).attr('id');
                    if (id) {
                        id = id.replace(/_\d+__/, '_' + rowIndex + '__');
                        $(this).attr('id', id);
                    }
                    $(this).val(''); // Clear the value in the new row
                });

                // Update validation spans
                $newRow.find('span[data-valmsg-for]').each(function () {
                    var valmsgFor = $(this).attr('data-valmsg-for');
                    if (valmsgFor) {
                        valmsgFor = valmsgFor.replace(/\[\d+\]/, '[' + rowIndex + ']');
                        $(this).attr('data-valmsg-for', valmsgFor);
                    }
                    $(this).empty().removeClass('field-validation-error').addClass('field-validation-valid');
                });

                $tbody.append($newRow);

                // Re-parse the validator so it sees the newly added inputs
                var $form = $("form");
                $form.removeData("validator").removeData("unobtrusiveValidation");
                $.validator.unobtrusive.parse($form);
            });

            // Validate max 10 photos
            $('#photoUpload').on('change', function() {
                if (this.files.length > 10) {
                    alert('You can only upload up to 10 photos.');
                    this.value = ''; // clear the input
                }
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
