@model IEnumerable<EcommerceStore.Models.AdminFoodOrder>

@{
    ViewData["Title"] = "Food Orders";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2>All Food Orders</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Order</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (totalPages > 1)
{
    <div class="card border-0 shadow-sm mb-3 p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Showing page <span class="fw-bold">@currentPage</span> of <span class="fw-bold">@totalPages</span> (10 items per page)
            </div>
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"><i class="bi bi-chevron-left"></i> Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next <i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Delivery Date</th>
                <th>Delivery Options</th>
                <th>Created At</th>
                <th>Price</th>
                <th>Items Count</th>
                <th>Total Orders</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="fw-bold">#@order.Id</td>
                    <td>@order.DeliveryDate.ToString("MM/dd/yyyy")</td>
                    <td>
                        @if (order.IsHomeDeliveryAvailable && order.IsUptownDeliveryAvailable)
                        {
                            <span class="badge bg-primary text-white" title="Both Home and Uptown Delivery">
                                <i class="bi bi-house-door"></i> + <i class="bi bi-buildings"></i> Both
                            </span>
                        }
                        else if (order.IsHomeDeliveryAvailable)
                        {
                            <span class="badge bg-info text-dark" title="Home Delivery Only">
                                <i class="bi bi-house-door"></i> Home
                            </span>
                        }
                        else if (order.IsUptownDeliveryAvailable)
                        {
                            <span class="badge bg-warning text-dark" title="Uptown Delivery Only">
                                <i class="bi bi-buildings"></i> Uptown
                            </span>
                        }
                    </td>
                    <td>@order.CreatedAt.ToEstFormat()</td>
                    <td>@order.Price.ToString("C")</td>
                    <td>@order.Items.Count</td>
                    <td>
                        @{
                            var counts = ViewBag.CustomerOrderCounts as Dictionary<int, int>;
                            var count = counts != null && counts.ContainsKey(order.Id) ? counts[order.Id] : 0;
                        }
                        <span class="badge @(count > 0 ? "bg-primary" : "bg-secondary") rounded-pill px-3">@count</span>
                    </td>
                    <td>
                        @if (order.IsCancelled)
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="CustomerOrders" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white" title="View Customers">
                                <i class="bi bi-people-fill me-1"></i> Customers
                            </a>
                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" style="margin-left: 5px;">Edit</a>
                            @if (!order.IsCancelled)
                            {
                                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="margin-left: 5px;">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">No food orders found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <div class="card border-0 shadow-sm mt-3 p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Showing page <span class="fw-bold">@currentPage</span> of <span class="fw-bold">@totalPages</span> (10 items per page)
            </div>
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"><i class="bi bi-chevron-left"></i> Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next <i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}
