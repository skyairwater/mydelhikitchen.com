@model IEnumerable<EcommerceStore.Models.AdminFoodOrder>

@{
    ViewData["Title"] = "Food Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2>All Food Orders</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Order</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Delivery Date</th>
                <th>Created At</th>
                <th>Price</th>
                <th>Items Count</th>
                <th>Total Orders</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="fw-bold">#@order.Id</td>
                    <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.CreatedAt.ToString("g")</td>
                    <td>@order.Price.ToString("C")</td>
                    <td>@order.Items.Count</td>
                    <td>
                        @{
                            var counts = ViewBag.CustomerOrderCounts as Dictionary<int, int>;
                            var count = counts != null && counts.ContainsKey(order.Id) ? counts[order.Id] : 0;
                        }
                        <span class="badge @(count > 0 ? "bg-primary" : "bg-secondary") rounded-pill px-3">@count</span>
                    </td>
                    <td>
                        @if (order.IsCancelled)
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="CustomerOrders" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white" title="View Customers">
                                <i class="bi bi-people-fill me-1"></i> Customers
                            </a>
                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" style="margin-left: 5px;">Edit</a>
                            @if (!order.IsCancelled)
                            {
                                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="margin-left: 5px;">Cancel</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No food orders found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
