@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Delhi Kitchen</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <meta name="description" content="Authentic Indian Food, Groceries, and Catering in Charlotte, NC. Discover the best Indian flavors at Delhi Kitchen." />
    <meta name="keywords" content="delhi kitchen, charlotte, indian food, best indian food in charlotte, indian groceries charlotte, north indian food charlotte, indian catering" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mydelhikitchen.com/" />
    <meta property="og:title" content="Delhi Kitchen - Authentic Indian Food & Groceries in Charlotte" />
    <meta property="og:description" content="Pure vegetarian, prepared fresh daily, delivery at your door steps, lowest price in charlotte!" />
    <meta property="og:image" content="~/images/delhikitchenlogo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceStore.styles.css" asp-append-version="true" />
    <script>
        (function () {
            let theme = localStorage.getItem('theme') || 'cool-fog';
            if (theme === 'light') theme = 'cool-fog';
            const bsTheme = theme === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', bsTheme);
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark border-bottom fixed-top shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold d-inline-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <!-- US Flag -->
                    <!-- India Flag -->
                    <svg class="rounded shadow-sm" style="width: 22px; height: 15px; flex-shrink: 0;" viewBox="0 0 900 600" aria-label="India Flag">
                        <rect width="900" height="200" fill="#FF9933"/>
                        <rect width="900" height="200" y="200" fill="#FFFFFF"/>
                        <rect width="900" height="200" y="400" fill="#138808"/>
                        <!-- Ashoka Chakra -->
                        <circle cx="450" cy="300" r="80" fill="none" stroke="#000080" stroke-width="8"/>
                        <circle cx="450" cy="300" r="16" fill="#000080"/>
                        <path d="M450,220v160 M410,225l80,150 M375,240l150,120 M350,265l200,70 M338,300h224 M350,335l200,-70 M375,360l150,-120 M410,375l80,-150 M490,225l-80,150 M525,240l-150,120 M550,265l-200,70 M550,335l-200,-70" stroke="#000080" stroke-width="3"/>
                    </svg>
                    <span>Delhi Kitchen</span>
                    <!-- US Flag -->
                    <svg class="rounded shadow-sm" style="width: 22px; height: 15px; flex-shrink: 0;" viewBox="0 0 7410 3900" aria-label="US Flag">
                        <rect width="7410" height="3900" fill="#b22234"/>
                        <path d="M0,450H7410M0,1050H7410M0,1650H7410M0,2250H7410M0,2850H7410M0,3450H7410" stroke="#fff" stroke-width="300"/>
                        <rect width="2964" height="2100" fill="#3c3b6e"/>
                        <g fill="#fff">
                            <g id="s18">
                                <g id="s9">
                                    <g id="s5">
                                        <g id="s4">
                                            <path id="s" d="M247,90 317,307 134,173H360L177,307z"/>
                                            <use href="#s" y="420"/>
                                            <use href="#s" y="840"/>
                                            <use href="#s" y="1260"/>
                                        </g>
                                        <use href="#s" y="1680"/>
                                    </g>
                                    <use href="#s4" x="247" y="210"/>
                                </g>
                                <use href="#s9" x="494"/>
                            </g>
                            <use href="#s18" x="988"/>
                            <use href="#s9" x="1976"/>
                            <use href="#s5" x="2470"/>
                        </g>
                    </svg>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNavbarOffcanvas" aria-controls="mainNavbarOffcanvas"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="mainNavbarOffcanvas" aria-labelledby="mainNavbarOffcanvasLabel">
                    <div class="offcanvas-header border-bottom d-md-none">
                        <h5 class="offcanvas-title fw-bold d-inline-flex align-items-center gap-2" id="mainNavbarOffcanvasLabel">
                            <svg class="rounded shadow-sm" style="width: 20px; height: 14px; flex-shrink: 0;" viewBox="0 0 900 600">
                                <rect width="900" height="200" fill="#FF9933"/>
                                <rect width="900" height="200" y="200" fill="#FFFFFF"/>
                                <rect width="900" height="200" y="400" fill="#138808"/>
                                <circle cx="450" cy="300" r="80" fill="none" stroke="#000080" stroke-width="8"/>
                            </svg>
                            <span>Delhi Kitchen</span>
                            <svg class="rounded shadow-sm" style="width: 20px; height: 14px; flex-shrink: 0;" viewBox="0 0 7410 3900">
                                <rect width="7410" height="3900" fill="#b22234"/>
                                <path d="M0,450H7410M0,1050H7410M0,1650H7410M0,2250H7410M0,2850H7410M0,3450H7410" stroke="#fff" stroke-width="300"/>
                                <rect width="2964" height="2100" fill="#3c3b6e"/>
                            </svg>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body py-0">
                        <div class="navbar-collapse d-md-inline-flex justify-content-between w-100">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Groceries">Groceries</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Food" asp-action="Index">Food</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Catering">Catering</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                                </li>
                                @if (User.HasClaim("IsAdmin", "True"))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Admin
                                        </a>
                                        <ul class="dropdown-menu shadow-sm" aria-labelledby="adminDropdown">
                                            <li><h6 class="dropdown-header">Orders</h6></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="AdminFoodOrder" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>New Food Order</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="AdminFoodOrder" asp-action="Index"><i class="bi bi-list-ul me-2"></i>Show All Food Orders</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Orders" asp-action="AdminIndex"><i class="bi bi-cart-check me-2"></i>Show All Grocery Orders</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Grocery</h6></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Products" asp-action="Index"><i class="bi bi-box me-2"></i>Manage Products</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-2"></i>Manage Categories</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Website</h6></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Maintenance" asp-action="Index"><i class="bi bi-wrench-adjustable me-2"></i>Website Maintenance</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="DeliveryLocations" asp-action="Index"><i class="bi bi-geo-alt me-2"></i>Manage Delivery Locations</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="AdminMessages" asp-action="Index"><i class="bi bi-chat-left-text me-2"></i>Manage Messages</a></li>
                                        </ul>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                            </ul>
                            <div class="d-flex align-items-center me-md-3 border-end-md pe-md-3 mb-3 mb-md-0">
                                <div class="dropdown me-2">
                                    <button class="btn btn-link nav-link dropdown-toggle d-flex align-items-center gap-1 px-2 border-0" 
                                            type="button" id="themeDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Select Mood" style="color: inherit;">
                                        <i class="bi bi-palette-fill me-1" id="theme-swatch-current" style="font-size: 0.85rem; color: #2C5E8A;"></i>
                                        <span class="small fw-semibold">Mood</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border py-2" aria-labelledby="themeDropdown" style="min-width: 215px;">
                                        <li><h6 class="dropdown-header text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Light Moods</h6></li>
                                        <li>
                                            <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-select-btn" data-theme="fresh-green">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: #236348; display: inline-block;"></span>
                                                    <span>Fresh Green</span>
                                                </div>
                                                <i class="bi bi-check2 theme-check-icon d-none fw-bold" style="color: var(--primary-color);"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-select-btn" data-theme="warm-linen">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: #B85D3A; display: inline-block;"></span>
                                                    <span>Warm Linen</span>
                                                </div>
                                                <i class="bi bi-check2 theme-check-icon d-none fw-bold" style="color: var(--primary-color);"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-select-btn" data-theme="cool-fog">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: #2C5E8A; display: inline-block;"></span>
                                                    <span>Cool Fog</span>
                                                </div>
                                                <i class="bi bi-check2 theme-check-icon d-none fw-bold" style="color: var(--primary-color);"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-select-btn" data-theme="baby-pink">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: #C84B70; display: inline-block;"></span>
                                                    <span>Baby Pink</span>
                                                </div>
                                                <i class="bi bi-check2 theme-check-icon d-none fw-bold" style="color: var(--primary-color);"></i>
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider my-2"></li>
                                        <li><h6 class="dropdown-header text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Dark Mode</h6></li>
                                        <li>
                                            <button class="dropdown-item d-flex align-items-center justify-content-between py-2 theme-select-btn" data-theme="dark">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: #121E17; display: inline-block;"></span>
                                                    <span class="theme-label-dark" style="color: #111827 !important; font-weight: 600;">Midnight Dark</span>
                                                </div>
                                                <i class="bi bi-check2 theme-check-icon d-none fw-bold" style="color: var(--primary-color);"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                @{
                                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                                    var isGroceriesPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) && 
                                                          string.Equals(currentAction, "Groceries", StringComparison.OrdinalIgnoreCase);
                                }
                                @if (isGroceriesPage)
                                {
                                    <button class="btn btn-outline-light position-relative p-1 px-2 border-0" data-bs-toggle="modal" data-bs-target="#cart-modal" id="cart-btn" style="color: inherit; border-color: currentColor !important;">
                                        <i class="bi bi-cart3 fs-4"></i>
                                        <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill" style="display: none;">
                                            0
                                        </span>
                                    </button>
                                }
                            </div>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MyDelhiKitchen.com - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Shopping Cart Modal -->
    <div class="modal fade" id="cart-modal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-70">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="cartModalLabel">Your Cart</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div id="cart-items-container">
                        <!-- Cart items will be rendered here -->
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0" id="cart-modal-footer">
                    <div class="w-100">
                        <div class="d-flex justify-content-between h5 fw-bold mb-3">
                            <span>Total:</span>
                            <span id="cart-modal-total">$0.00</span>
                        </div>
                        <button type="button" class="btn btn-primary w-100 py-2 rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#checkoutModal">Proceed to Checkout</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirm Empty Cart Modal -->
    <div class="modal fade" id="confirm-empty-cart-modal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0 text-center">
                <div class="modal-body py-4">
                    <i class="bi bi-trash3 text-danger mb-3 d-block" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold">Empty your cart?</h5>
                    <p class="text-muted small">This will remove all items from your order summary.</p>
                    <div class="d-grid gap-2 mt-4">
                        <button type="button" class="btn btn-danger py-2 fw-bold" id="confirm-clear-cart">Yes, Empty Cart</button>
                        <button type="button" class="btn btn-link text-muted btn-sm text-decoration-none" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
            <div class="modal-content shadow border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Complete Your Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Orders" asp-action="Checkout" method="post" id="checkout-form" autocomplete="on">
                    <div class="modal-body">
                        <div class="alert alert-success">You can pay cash or zelle to Pinki Basra 980.370.1091</div>
                        <p class="opacity-75">Enter your details to receive your unique Order ID.</p>
                        <div class="mb-3">
                            <label for="CustomerEmail" class="form-label">
                                Email Address <span class="text-muted fw-normal small">(Provide your valid email address, receipt will be sent here)</span>
                            </label>
                            <input type="email" name="CustomerEmail" id="CustomerEmail" class="form-control" required placeholder="name@example.com" autocomplete="email">
                        </div>
                        <div class="mb-3">
                            <label for="PhoneNumber" class="form-label">
                                Phone Number (US Format) <span class="text-muted fw-normal small">(Please provide your cell number, we will call you in case of any last minute issues)</span>
                            </label>
                            <input type="tel" name="PhoneNumber" id="PhoneNumber" class="form-control" required 
                                   placeholder="(555) 555-5555" 
                                   autocomplete="tel"
                                   pattern="^\(?([0-9]{3})\)?[-. ]?([0-9]{3})[-. ]?([0-9]{4})$"
                                   title="Please enter a valid US phone number (e.g. (555) 555-5555 or 555-555-5555)">
                        </div>
                        <div class="mb-3">
                            <label for="DeliveryAddress" class="form-label">Delivery Address</label>
                            <input type="text" name="DeliveryAddress" id="DeliveryAddress" class="form-control" required autocomplete="street-address" placeholder="Start typing your address...">
                        </div>
                        <div id="cart-data-container"></div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-link text-muted" data-bs-dismiss="modal">Keep Shopping</button>
                        <button type="submit" class="btn btn-primary px-4">Place Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Google Maps API for Autocomplete -->
    <script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&libraries=places"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
