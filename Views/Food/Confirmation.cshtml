@model EcommerceStore.Models.CustomerFoodOrder

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5 mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white py-2 px-3 text-center border-0">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-check-circle-fill text-white" style="font-size: 1.2rem;"></i>
                        <span class="fw-bold fs-5">Order Confirmed!</span>
                    </div>
                    <div class="opacity-75 small" style="font-size: 0.8rem;">Thank you for your order, @Model.CustomerEmail</div>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white">
                    <div class="row mb-5 border-bottom pb-4">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <h6 class="text-muted text-uppercase fw-bold mb-2">Order Reference</h6>
                            <span class="badge bg-light text-dark fs-5 font-monospace border">@Model.UniqueOrderId</span>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <h6 class="text-muted text-uppercase fw-bold mb-2">Order Date</h6>
                            <p class="fs-5 fw-semibold mb-0">@Model.OrderDate.ToEstFormat()</p>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h4 class="fw-bold text-dark mb-4 border-bottom pb-2"><i class="bi bi-truck me-2 text-primary"></i>Delivery Details</h4>
                        
                        <div class="row g-3">
                            @if(Model.AdminFoodOrder != null)
                            {
                                <div class="col-sm-4 text-muted fw-semibold">Delivery Date:</div>
                                <div class="col-sm-8 fw-bold text-success">@Model.AdminFoodOrder.DeliveryDate.ToString("MMMM dd, yyyy")</div>
                            }

                            <div class="col-sm-4 text-muted fw-semibold">
                                @(Model.DeliveryAddress.StartsWith("Uptown Pickup:", StringComparison.OrdinalIgnoreCase) ? "Pickup Spot:" : "Delivery Address:")
                            </div>
                            <div class="col-sm-8 fw-bold">@Model.DeliveryAddress</div>

                            <div class="col-sm-4 text-muted fw-semibold">Your Phone Number:</div>
                            <div class="col-sm-8 fw-bold">@Model.PhoneNumber</div>

                            <div class="col-sm-4 text-muted fw-semibold">For Questions:</div>
                            <div class="col-sm-8 fw-bold">
                                <a href="tel:3133980524" class="text-decoration-none text-primary">313.398.0524</a>
                            </div>
                        </div>

                        @if (ViewBag.PickupLocation != null)
                        {
                            var loc = (EcommerceStore.Models.DeliveryLocation)ViewBag.PickupLocation;
                            <div class="mt-4 pt-3 border-top">
                                <h6 class="fw-bold text-dark mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>Pickup Location Map: <span class="text-primary">@loc.Name</span>
                                </h6>
                                @if (!string.IsNullOrWhiteSpace(loc.Description))
                                {
                                    <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i>@loc.Description</p>
                                }
                                <div class="rounded-4 overflow-hidden border shadow-sm" style="height: 350px;" id="confirmationPickupMap"
                                     data-lat="@loc.Latitude" data-lng="@loc.Longitude" data-name="@loc.Name" data-desc="@(loc.Description ?? "")">
                                </div>
                            </div>
                        }
                    </div>

                    @if(Model.AdminFoodOrder != null && !string.IsNullOrWhiteSpace(Model.AdminFoodOrder.Comments))
                    {
                        <div class="alert bg-warning bg-opacity-10 border border-warning-subtle rounded-3 p-4 mb-5">
                            <h6 class="alert-heading fw-bold text-warning-emphasis mb-2"><i class="bi bi-chat-quote-fill me-2"></i>Chef's Note for this Menu</h6>
                            <p class="mb-0 text-dark">@Model.AdminFoodOrder.Comments</p>
                        </div>
                    }

                    <div>
                        <h4 class="fw-bold text-dark mb-4 border-bottom pb-2"><i class="bi bi-receipt me-2 text-primary"></i>Order Summary</h4>
                        
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="fw-semibold text-dark fs-5">Main Meal Package</span>
                                <div class="text-muted small">@Model.MainQuantity persons &times; @Model.BasePrice.ToString("C")</div>
                            </div>
                            <span class="fs-5 fw-semibold">@((Model.BasePrice * Model.MainQuantity).ToString("C"))</span>
                        </div>

                        @if (Model.AlaCarteItems != null && Model.AlaCarteItems.Any())
                        {
                            <hr class="text-muted opacity-25 my-3" />
                            <h6 class="text-muted text-uppercase fw-bold mb-3 small">A la Carte Add-ons</h6>
                            
                            @foreach (var item in Model.AlaCarteItems)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="text-dark">
                                        <span class="badge bg-secondary rounded-pill me-2">@item.Quantity x</span>
                                        @item.Name
                                    </div>
                                    <span class="text-dark">@((item.Price * item.Quantity).ToString("C"))</span>
                                </div>
                            }
                        }

                        <hr class="my-4" />
                        
                        @if (Model.DeliveryCharge > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted fw-semibold">Delivery Charge</span>
                                <span class="fs-5 text-dark">@Model.DeliveryCharge.ToString("C")</span>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center bg-light p-4 rounded-3 border mt-4">
                            <span class="text-dark fs-4 fw-bold">Order Total</span>
                            <span class="fs-3 fw-bold text-primary">@Model.TotalAmount.ToString("C")</span>
                        </div>
                    </div>

                    <div class="text-center mt-5 pt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            Return to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        if (typeof localStorage !== 'undefined') {
            localStorage.setItem('customer_email', '@Model.CustomerEmail');
            localStorage.setItem('customer_phone', '@Model.PhoneNumber');
        }
    </script>
    @if (ViewBag.PickupLocation != null)
    {
        <!-- Leaflet CSS & JS -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const mapElem = document.getElementById('confirmationPickupMap');
                if (mapElem) {
                    const lat = parseFloat(mapElem.getAttribute('data-lat')) || 35.2271;
                    const lng = parseFloat(mapElem.getAttribute('data-lng')) || -80.8431;
                    const name = mapElem.getAttribute('data-name') || 'Pickup Spot';
                    const desc = mapElem.getAttribute('data-desc') || '';

                    const map = L.map('confirmationPickupMap').setView([lat, lng], 16);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    L.marker([lat, lng]).addTo(map)
                        .bindPopup(`<strong>${name}</strong><br/>${desc}`)
                        .openPopup();
                }
            });
        </script>
    }
}
