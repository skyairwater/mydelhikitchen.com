@model EcommerceStore.Models.AdminFoodOrder

@{
    ViewData["Title"] = "Today's Food Menu";
}

<div class="container mt-5 mb-5 pb-5">
    @if (Model == null)
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h2 class="text-muted mt-3 fw-bold">No Food Delievery Menu</h2>
            <p class="fs-5 text-secondary">Come back later for delicious catering options!</p>
        </div>
    }
    else
    {
        <!-- Top Status & Alerts Bar Container -->
        <div class="card shadow-sm border rounded-4 p-3 mb-4" style="background-color: var(--card-bg);">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white rounded-pill fs-6 px-3 py-2 shadow-sm border border-primary-subtle">
                        <i class="bi bi-calendar-check me-2"></i> Delivery Date: @Model.DeliveryDate.ToString("MMMM dd, yyyy")
                    </span>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    @if (Model.MaxOrders.HasValue)
                    {
                        <div class="live-viewer-stats rounded-pill border shadow-sm px-3 py-2" id="viewer-badge" style="font-size: 0.95rem;">
                            <span class="status-pulse me-2"></span>
                            <span id="viewer-count">...</span> <span id="viewer-text" class="ms-1">Users watching</span>
                        </div>
                        @if (ViewBag.RemainingOrders != null)
                        {
                            var remaining = (int)ViewBag.RemainingOrders;
                            var remainingClass = remaining > 5 ? "bg-info border-info-subtle" : "bg-danger text-white border-danger";
                            <span class="badge @remainingClass rounded-pill fs-6 px-3 py-2 shadow-sm border">
                                <i class="bi bi-hourglass-split me-2"></i> Remaining Orders: @Math.Max(0, remaining)
                            </span>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="row g-4 position-relative">

            <!-- Left Column: Menu Description & Photos -->
            <div class="col-lg-7 pb-4">

                @{
                    var beverageList = Model.Items?.Where(i => i.Category == "Beverage").ToList() ?? new List<EcommerceStore.Models.AdminFoodOrderItem>();
                    var alaCarteList = Model.Items?.Where(i => i.Category != "Beverage").ToList() ?? new List<EcommerceStore.Models.AdminFoodOrderItem>();
                }

                <!-- Card 1: Lunch Menu (including Beverages) -->
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-primary text-white py-2 px-3 border-0 shadow-sm z-1 position-relative">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-card-list me-2" style="color: var(--accent-color);"></i> Lunch Menu</h5>
                    </div>
                    <div class="card-body p-3 p-md-4 position-relative">
                        <div class="menu-content" style="font-size: 1.1rem; line-height: 1.8;">
                            @if (!string.IsNullOrWhiteSpace(Model.Menu))
                            {
                                @Html.Raw(Model.Menu)
                            }
                            else
                            {
                                <p class="text-muted fst-italic">No menu description provided by the chef.</p>
                            }
                        </div>

                        <!-- Special Menu Order Quantity Stepper -->
                        <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div>
                                <label for="quantity" class="form-label fw-bold text-dark mb-0 fs-6">
                                    <i class="bi bi-basket3-fill me-2" style="color: var(--primary-color);"></i>Lunch Quantity
                                </label>
                                <span class="d-block text-muted small">Select quantity for Lunch Menu</span>
                            </div>
                            <div style="width: 130px;">
                                <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary" type="button" id="btnMainQtyMinus"><i class="bi bi-dash"></i></button>
                                    <input type="number" id="quantity" class="form-control border-secondary-subtle text-center fw-bold" min="1" value="1" required style="background-color: white;" />
                                    <button class="btn btn-outline-secondary" type="button" id="btnMainQtyPlus"><i class="bi bi-plus"></i></button>
                                </div>
                            </div>
                        </div>

                        @if (beverageList.Any())
                        {
                            <hr class="my-3 border-secondary opacity-25" />
                            <h6 class="fw-bold mb-3 text-secondary text-uppercase tracking-wider small"><i class="bi bi-cup-straw me-2"></i>Beverages</h6>
                            <ul class="list-group list-group-flush rounded-3 border mb-0">
                                @foreach(var item in beverageList)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light py-2 px-3 border-bottom ala-carte-item" data-id="@item.Id" data-name="@item.Name" data-price="@(item.Price ?? 0)">
                                        <div>
                                            <span class="fw-semibold text-dark">@item.Name</span>
                                            @if(item.Price.HasValue)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 ms-2 ala-carte-price">
                                                    @item.Price.Value.ToString("C")
                                                </span>
                                            }
                                        </div>
                                        <div style="width: 110px;">
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary btn-minus" type="button"><i class="bi bi-dash"></i></button>
                                                <input type="number" class="form-control text-center ala-carte-qty" value="0" min="0" readonly style="background-color: white;" name="AlaCarte[@item.Id]" />
                                                <button class="btn btn-outline-secondary btn-plus" type="button"><i class="bi bi-plus"></i></button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <!-- Card 2: A la Carte Selection -->
                @if (alaCarteList.Any())
                {
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                        <div class="card-header bg-primary text-white py-2 px-3 border-0 shadow-sm z-1 position-relative">
                            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-basket2-fill me-2" style="color: var(--accent-color);"></i> A la Carte Selection</h5>
                        </div>
                        <div class="card-body p-3 p-md-4 position-relative">
                            <ul class="list-group list-group-flush rounded-3 border mb-0">
                                @foreach(var item in alaCarteList)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light py-2 px-3 border-bottom ala-carte-item" data-id="@item.Id" data-name="@item.Name" data-price="@(item.Price ?? 0)">
                                        <div>
                                            <span class="fw-semibold text-dark">@item.Name</span>
                                            @if(item.Price.HasValue)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 ms-2 ala-carte-price">
                                                    @item.Price.Value.ToString("C")
                                                </span>
                                            }
                                        </div>
                                        <div style="width: 110px;">
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary btn-minus" type="button"><i class="bi bi-dash"></i></button>
                                                <input type="number" class="form-control text-center ala-carte-qty" value="0" min="0" readonly style="background-color: white;" name="AlaCarte[@item.Id]" />
                                                <button class="btn btn-outline-secondary btn-plus" type="button"><i class="bi bi-plus"></i></button>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <!-- Carousel for Images -->
                @if (Model.PhotoPaths != null && Model.PhotoPaths.Any())
                {
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                        <div id="foodCarousel" class="carousel slide carousel-fade shadow-sm" data-bs-ride="carousel">
                            @if (Model.PhotoPaths.Count > 1)
                            {
                                <div class="carousel-indicators mb-2">
                                    @for (int i = 0; i < Model.PhotoPaths.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#foodCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                                    }
                                </div>
                            }
                            <div class="carousel-inner bg-dark">
                                @for (int i = 0; i < Model.PhotoPaths.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@Model.PhotoPaths[i]" class="d-block w-100" alt="Food preview @(i+1)" style="object-fit: contain; max-height: 450px; width: 100%;" />
                                    </div>
                                }
                            </div>
                            @if (Model.PhotoPaths.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#foodCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon p-3 bg-dark bg-opacity-50 rounded-circle shadow" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#foodCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon p-3 bg-dark bg-opacity-50 rounded-circle shadow" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column: Order Form & Pricing Details -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden sticky-top" style="top: 80px;">
                    <div class="card-header bg-primary text-white py-2 px-3 border-0 text-center">
                        <h5 class="fw-bold mb-0">Order Details</h5>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1">
                            <div>
                                <span class="text-secondary fw-semibold">Lunch Package</span>
                                <span class="badge bg-light text-dark border ms-1" id="lunchQtyBadge">1x</span>
                            </div>
                            <span class="fw-bold text-dark" id="lunchTotalDisplay">@Model.Price.ToString("C")</span>
                        </div>
                        <div class="text-muted small mb-2 text-end" style="font-size: 0.8rem; margin-top: -4px;">
                            <span id="basePriceDisplay" data-base-price="@Model.Price">@Model.Price.ToString("C")</span> / unit
                        </div>
                        
                        @if (Model.DeliveryCharge > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2">
                                <span class="text-secondary fw-semibold">Delivery Charge</span>
                                <span class="fw-bold text-success" id="deliveryChargeDisplay" data-delivery="@Model.DeliveryCharge">@Model.DeliveryCharge.ToString("C")</span>
                            </div>
                        }
                        else
                        {
                            <span id="deliveryChargeDisplay" data-delivery="0" class="d-none"></span>
                        }

                        @if (Model.AddTaxToCustomers)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1" id="taxRow">
                                <span class="text-secondary fw-semibold">Sales Tax (@Model.TaxPercentage%)</span>
                                <span class="fw-bold text-dark" id="taxDisplay" data-tax-rate="@Model.TaxPercentage">$0.00</span>
                            </div>
                        }
                        else
                        {
                            <span id="taxDisplay" data-tax-rate="0" class="d-none"></span>
                        }

                        <div id="alaCarteSummaryContainer" class="mb-2 d-none">
                            <h6 class="fw-bold text-secondary mb-2 small">A la Carte Add-ons</h6>
                            <div id="alaCarteSummaryList" class="small mb-2 pb-2">
                                <!-- Dynamic items will be injected here -->
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 mb-3">
                            <span class="text-dark fs-5 fw-bold">Total Estimate</span>
                            <span class="fs-4 fw-bold text-primary" id="grandTotalDisplay">$0.00</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Comments))
                        {
                            <div class="alert bg-info bg-opacity-10 border border-info border-opacity-25 rounded-3 mb-3 p-3 text-dark shadow-sm">
                                <h6 class="alert-heading fw-bold text-info-emphasis mb-1 small"><i class="bi bi-chat-quote-fill me-2"></i>Chef's Note</h6>
                                <p class="mb-0 small" style="line-height: 1.5;">@Model.Comments</p>
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">
                                @TempData["Error"]
                            </div>
                        }
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success py-2 small" role="alert">
                                @TempData["Message"]
                            </div>
                        }

                        <div class="mt-2 text-start">
                            @if (ViewBag.RemainingOrders != null && (int)ViewBag.RemainingOrders <= 0)
                            {
                                <div class="alert alert-danger fw-bold text-center mt-2 p-2 rounded-pill shadow-sm small">
                                    <i class="bi bi-x-circle-fill me-2"></i> SOLD OUT
                                </div>
                                <button type="button" class="btn btn-secondary w-100 shadow rounded-pill fw-bold py-2 mt-2 text-uppercase tracking-wider" disabled>
                                    Sold Out <i class="bi bi-slash-circle ms-1 align-middle"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary w-100 shadow rounded-pill fw-bold py-2 mt-2 text-uppercase tracking-wider transition-all" id="btnOrderNow">
                                    Proceed to Order <i class="bi bi-arrow-down-short ms-1 fs-5 align-middle"></i>
                                </button>
                                <div class="text-center mt-2 text-danger opacity-75 fw-semibold small" style="font-size: 0.8rem;">
                                    <i class="bi bi-info-circle-fill me-1"></i> Food once ordered cannot be cancelled
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inline Complete Food Order Section at Bottom -->
        <div class="row justify-content-center mt-5 pt-3" id="completeOrderSection" style="display: none;">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white py-3 px-4 border-0 text-center">
                        <h4 class="fw-bold mb-0"><i class="bi bi-bag-check-fill me-2" style="color: var(--accent-color);"></i>Complete Food Order</h4>
                    </div>
                    <form asp-controller="Food" asp-action="Checkout" method="post" id="food-checkout-form" autocomplete="on">
                        <div class="card-body p-4 p-md-5">
                            <div class="alert alert-success d-flex align-items-center mb-4">
                                <i class="bi bi-cash-coin fs-4 me-3"></i>
                                <div>You can pay cash or zelle to Pinki Basra <strong>980.370.1091</strong></div>
                            </div>
                            <p class="text-muted">Enter your details below to receive your unique Order ID and confirmation.</p>
                            
                            <div class="mb-3">
                                <label for="FoodCustomerEmail" class="form-label fw-semibold">
                                    Email Address <span class="text-muted fw-normal small">(Provide your valid email address, receipt will be sent here)</span>
                                </label>
                                <input type="email" name="CustomerEmail" id="FoodCustomerEmail" class="form-control" required placeholder="name@example.com" autocomplete="email">
                            </div>
                            <div class="mb-3">
                                <label for="FoodPhoneNumber" class="form-label fw-semibold">
                                    Phone Number (US Format) <span class="text-muted fw-normal small">(Please provide your cell number, we will call you in case of any last minute issues)</span>
                                </label>
                                <input type="tel" name="PhoneNumber" id="FoodPhoneNumber" class="form-control" required 
                                       placeholder="(555) 555-5555" 
                                       autocomplete="tel"
                                       pattern="^\(?([0-9]{3})\)?[-. ]?([0-9]{3})[-. ]?([0-9]{4})$"
                                       title="Please enter a valid US phone number (e.g. (555) 555-5555 or 555-555-5555)">
                            </div>
                            @{
                                var uptownLocs = ViewBag.UptownLocations as List<EcommerceStore.Models.DeliveryLocation> ?? new List<EcommerceStore.Models.DeliveryLocation>();
                                var hasUptown = Model.IsUptownDeliveryAvailable && uptownLocs.Any();
                                var hasHome = Model.IsHomeDeliveryAvailable;
                            }

                            @if (hasHome && hasUptown)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Delivery Method</label>
                                    <div class="d-flex gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input delivery-type-radio" type="radio" name="DeliveryType" id="deliveryTypeHome" value="Home" checked>
                                            <label class="form-check-label fw-semibold" for="deliveryTypeHome">
                                                <i class="bi bi-house-door text-primary me-1"></i>Home Delivery
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input delivery-type-radio" type="radio" name="DeliveryType" id="deliveryTypeUptown" value="Uptown">
                                            <label class="form-check-label fw-semibold" for="deliveryTypeUptown">
                                                <i class="bi bi-buildings text-primary me-1"></i>Uptown Delivery
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (hasUptown && !hasHome)
                            {
                                <input type="hidden" name="DeliveryType" id="deliveryTypeUptown" value="Uptown" />
                            }
                            else
                            {
                                <input type="hidden" name="DeliveryType" id="deliveryTypeHome" value="Home" />
                            }

                            <!-- Home Delivery Address input -->
                            <div class="mb-4" id="homeAddressContainer" style="display: @(hasHome || !hasUptown ? "block" : "none");">
                                <label for="FoodDeliveryAddress" class="form-label fw-semibold">Delivery Address</label>
                                <input type="text" name="DeliveryAddress" id="FoodDeliveryAddress" class="form-control" autocomplete="street-address" placeholder="Start typing your address..." @(hasHome || !hasUptown ? "required" : "")>
                            </div>

                            <!-- Uptown Delivery Location Selection -->
                            @if (hasUptown)
                            {
                                <div class="mb-4" id="uptownLocationContainer" style="display: @(!hasHome ? "block" : "none");">
                                    <label class="form-label fw-semibold">Select Uptown Delivery Location</label>
                                    <select class="form-select" id="uptownLocationSelect">
                                        @foreach (var loc in uptownLocs)
                                        {
                                            var optionLabel = string.IsNullOrWhiteSpace(loc.Description) 
                                                ? loc.Name 
                                                : $"{loc.Name} - {loc.Description}";
                                            <option value="@loc.Name" data-id="@loc.Id" data-name="@loc.Name" data-desc="@(loc.Description ?? "")" data-lat="@loc.Latitude" data-lng="@loc.Longitude">
                                                @optionLabel
                                            </option>
                                        }
                                    </select>
                                    <div class="mt-2">
                                        <a href="javascript:void(0)" class="text-primary fw-bold text-decoration-none view-location-map-btn" id="btnOpenLocationMap">
                                            <i class="bi bi-geo-alt-fill me-1 text-danger"></i><span id="selectedLocationNameDisplay">@uptownLocs.First().Name</span> (View on Map)
                                        </a>
                                    </div>
                                </div>
                            }

                            <div id="food-cart-data-container"></div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="btnCancelOrderSection">Cancel</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow">
                                    Place Order Now <i class="bi bi-check2-circle ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model != null)
{
    <!-- Leaflet Delivery Location Map Modal -->
    <div class="modal fade" id="deliveryLocationMapModal" tabindex="-1" aria-labelledby="mapModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-2 px-3 border-0">
                    <h5 class="modal-title fw-bold mb-0" id="mapModalTitle">
                        <i class="bi bi-geo-alt-fill me-2" style="color: var(--accent-color);"></i>
                        <span id="mapModalLocationName">Delivery Location</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 position-relative">
                    <div id="modalLeafletMap" style="height: 420px; width: 100%;"></div>
                </div>
                <div class="modal-footer py-2 px-3 border-0 bg-light d-flex justify-content-between align-items-center">
                    <div id="mapModalDescription" class="text-muted small"></div>
                    <button type="button" class="btn btn-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    .menu-content ul { padding-left: 2rem; }
    .menu-content li { margin-bottom: 0.5rem; }
    #btnOrderNow:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(13,110,253,.2)!important; }
    .tracking-wider { letter-spacing: 0.05em; }
    .transition-all { transition: all 0.3s ease; }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/viewingHub")
            .withAutomaticReconnect()
            .build();

        connection.on("UpdateViewerCount", (count) => {
            const countElem = document.getElementById('viewer-count');
            const textElem = document.getElementById('viewer-text');
            if (countElem && textElem) {
                countElem.innerText = count;
                textElem.innerText = (count === 1) ? "User watching" : "Users watching";
            }
        });


        connection.start().then(() => {
            console.log("SignalR Connected");
            connection.invoke("GetCurrentCount");
        }).catch(err => console.error(err.toString()));

        @if (Model != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                const basePrice = parseFloat(document.getElementById('basePriceDisplay').getAttribute('data-base-price')) || 0;
                const deliveryCharge = parseFloat(document.getElementById('deliveryChargeDisplay').getAttribute('data-delivery')) || 0;
                const taxDisplay = document.getElementById('taxDisplay');
                const taxRate = taxDisplay ? (parseFloat(taxDisplay.getAttribute('data-tax-rate')) || 0) : 0;
                const mainQtyInput = document.getElementById('quantity');
                const lunchQtyBadge = document.getElementById('lunchQtyBadge');
                const lunchTotalDisplay = document.getElementById('lunchTotalDisplay');
                const grandTotalDisplay = document.getElementById('grandTotalDisplay');
                const alaCarteSummaryContainer = document.getElementById('alaCarteSummaryContainer');
                const alaCarteSummaryList = document.getElementById('alaCarteSummaryList');

                function getCurrencyFormat(amount) {
                    return '$' + amount.toFixed(2);
                }

                function recalculateTotals() {
                    let mainQty = parseInt(mainQtyInput.value);
                    if (isNaN(mainQty) || mainQty < 1) mainQty = 1;

                    let mainTotal = basePrice * mainQty;
                    if (lunchQtyBadge) {
                        lunchQtyBadge.innerText = mainQty + 'x';
                    }
                    if (lunchTotalDisplay) {
                        lunchTotalDisplay.innerText = getCurrencyFormat(mainTotal);
                    }
                    let alaCarteTotal = 0;
                    let hasAlaCarte = false;

                    alaCarteSummaryList.innerHTML = '';

                    document.querySelectorAll('.ala-carte-item').forEach(function(itemRow) {
                        const qtyInput = itemRow.querySelector('.ala-carte-qty');
                        const qty = parseInt(qtyInput.value) || 0;
                        
                        if (qty > 0) {
                            hasAlaCarte = true;
                            const name = itemRow.getAttribute('data-name');
                            const price = parseFloat(itemRow.getAttribute('data-price')) || 0;
                            const lineTotal = price * qty;
                            alaCarteTotal += lineTotal;

                            // Add to summary list
                            const lineElem = document.createElement('div');
                            lineElem.className = 'd-flex justify-content-between text-muted mb-1';
                            lineElem.innerHTML = `<span>${qty}x ${name}</span><span>${getCurrencyFormat(lineTotal)}</span>`;
                            alaCarteSummaryList.appendChild(lineElem);
                        }
                    });

                    if (hasAlaCarte) {
                        alaCarteSummaryContainer.classList.remove('d-none');
                    } else {
                        alaCarteSummaryContainer.classList.add('d-none');
                    }

                    const subtotal = mainTotal + alaCarteTotal;
                    let taxAmount = 0;
                    if (taxRate > 0) {
                        taxAmount = (subtotal * taxRate) / 100;
                        if (taxDisplay) {
                            taxDisplay.innerText = getCurrencyFormat(taxAmount);
                        }
                    }

                    const grandTotal = subtotal + deliveryCharge + taxAmount;
                    grandTotalDisplay.innerText = getCurrencyFormat(grandTotal);
                }

                if (mainQtyInput) {
                    mainQtyInput.addEventListener('input', recalculateTotals);
                    mainQtyInput.addEventListener('change', recalculateTotals);
                }

                const btnMainQtyPlus = document.getElementById('btnMainQtyPlus');
                if (btnMainQtyPlus) {
                    btnMainQtyPlus.addEventListener('click', function() {
                        mainQtyInput.value = (parseInt(mainQtyInput.value) || 0) + 1;
                        recalculateTotals();
                    });
                }

                const btnMainQtyMinus = document.getElementById('btnMainQtyMinus');
                if (btnMainQtyMinus) {
                    btnMainQtyMinus.addEventListener('click', function() {
                        let currentVal = parseInt(mainQtyInput.value) || 1;
                        if (currentVal > 1) {
                            mainQtyInput.value = currentVal - 1;
                            recalculateTotals();
                        }
                    });
                }

                document.querySelectorAll('.btn-plus').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        const input = this.parentElement.querySelector('.ala-carte-qty');
                        input.value = parseInt(input.value) + 1;
                        recalculateTotals();
                    });
                });

                document.querySelectorAll('.btn-minus').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        const input = this.parentElement.querySelector('.ala-carte-qty');
                        let val = parseInt(input.value);
                        if (val > 0) {
                            input.value = val - 1;
                            recalculateTotals();
                        }
                    });
                });
                
                // Toggle inline order section at bottom
                const btnOrderNow = document.getElementById('btnOrderNow');
                const completeOrderSection = document.getElementById('completeOrderSection');
                const btnCancelOrderSection = document.getElementById('btnCancelOrderSection');

                if (btnCancelOrderSection && completeOrderSection) {
                    btnCancelOrderSection.addEventListener('click', function() {
                        $(completeOrderSection).slideUp(300);
                        btnOrderNow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    });
                }

                // Phone formatting for Food checkout
                const foodPhoneInput = document.getElementById('FoodPhoneNumber');
                if (foodPhoneInput) {
                    foodPhoneInput.addEventListener('input', function(e) {
                        let x = e.target.value.replace(/\D/g, '').match(/(\d{0,3})(\d{0,3})(\d{0,4})/);
                        e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
                    });
                }

                // Pre-populate customer email & phone from localStorage if available
                function populateSavedFoodCustomerDetails() {
                    if (typeof localStorage !== 'undefined') {
                        const savedEmail = localStorage.getItem('customer_email');
                        const savedPhone = localStorage.getItem('customer_phone');
                        const emailInput = document.getElementById('FoodCustomerEmail');
                        const phoneInput = document.getElementById('FoodPhoneNumber');
                        if (savedEmail && emailInput && !emailInput.value) {
                            emailInput.value = savedEmail;
                        }
                        if (savedPhone && phoneInput && !phoneInput.value) {
                            phoneInput.value = savedPhone;
                        }
                    }
                }
                populateSavedFoodCustomerDetails();

                // Save to localStorage when food form is submitted
                const foodCheckoutForm = document.getElementById('food-checkout-form');
                if (foodCheckoutForm) {
                    foodCheckoutForm.addEventListener('submit', function() {
                        if (typeof localStorage !== 'undefined') {
                            const email = document.getElementById('FoodCustomerEmail')?.value?.trim();
                            const phone = document.getElementById('FoodPhoneNumber')?.value?.trim();
                            if (email) localStorage.setItem('customer_email', email);
                            if (phone) localStorage.setItem('customer_phone', phone);
                        }
                    });
                }

                // Google Places Autocomplete for FoodDeliveryAddress
                if (typeof google !== 'undefined') {
                    const foodAddrInput = document.getElementById("FoodDeliveryAddress");
                    if (foodAddrInput) {
                        const autocomplete = new google.maps.places.Autocomplete(foodAddrInput);
                        autocomplete.setFields(["address_components", "formatted_address"]);
                    }
                }

                // Delivery method radio toggle (Home vs Uptown)
                $('.delivery-type-radio').on('change', function() {
                    const isHome = $('#deliveryTypeHome').is(':checked');
                    if (isHome) {
                        $('#homeAddressContainer').slideDown(200);
                        $('#FoodDeliveryAddress').prop('required', true);
                        $('#uptownLocationContainer').slideUp(200);
                    } else {
                        $('#homeAddressContainer').slideUp(200);
                        $('#FoodDeliveryAddress').prop('required', false);
                        $('#uptownLocationContainer').slideDown(200);
                    }
                });

                // Update selected location display when dropdown changes
                $('#uptownLocationSelect').on('change', function() {
                    const selName = $(this).val();
                    $('#selectedLocationNameDisplay').text(selName);
                });

                // Leaflet Map modal setup
                let modalMap = null;
                let modalMarker = null;

                $('#btnOpenLocationMap').on('click', function(e) {
                    e.preventDefault();
                    const $selectedOpt = $('#uptownLocationSelect option:selected');
                    const locName = $selectedOpt.data('name') || $selectedOpt.val();
                    const locDesc = $selectedOpt.data('desc') || '';
                    const lat = parseFloat($selectedOpt.data('lat')) || 35.2271;
                    const lng = parseFloat($selectedOpt.data('lng')) || -80.8431;

                    $('#mapModalLocationName').text(locName);
                    $('#mapModalDescription').text(locDesc ? locDesc : 'Charlotte Uptown delivery pickup location.');

                    const mapModal = new bootstrap.Modal(document.getElementById('deliveryLocationMapModal'));
                    mapModal.show();

                    // Wait for modal to become visible before rendering Leaflet map
                    setTimeout(function() {
                        if (!modalMap) {
                            modalMap = L.map('modalLeafletMap').setView([lat, lng], 16);
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '&copy; OpenStreetMap contributors'
                            }).addTo(modalMap);
                        } else {
                            modalMap.invalidateSize();
                            modalMap.setView([lat, lng], 16);
                        }

                        if (modalMarker) {
                            modalMap.removeLayer(modalMarker);
                        }

                        modalMarker = L.marker([lat, lng]).addTo(modalMap)
                            .bindPopup(`<strong>${locName}</strong><br/>${locDesc}`)
                            .openPopup();
                    }, 300);
                });

                $('#deliveryLocationMapModal').on('shown.bs.modal', function () {
                    if (modalMap) {
                        modalMap.invalidateSize();
                    }
                });

                if (btnOrderNow) {
                    btnOrderNow.addEventListener('click', function(e) {
                        const cartContainer = document.getElementById('food-cart-data-container');
                        cartContainer.innerHTML = ''; // reset completely
                        
                        // Formulate main quantities
                        const adminOrderId = '@Model.Id';
                        const mainQty = parseInt(mainQtyInput.value) || 1;
                        
                        cartContainer.innerHTML += `<input type="hidden" name="AdminFoodOrderId" value="${adminOrderId}" />`;
                        cartContainer.innerHTML += `<input type="hidden" name="MainQuantity" value="${mainQty}" />`;
                        
                        // If Uptown delivery is selected, fill DeliveryAddress with selected Uptown location
                        const isUptownSelected = $('#deliveryTypeUptown').is(':checked') || ($('#deliveryTypeUptown').attr('type') === 'hidden' && $('#deliveryTypeUptown').val() === 'Uptown');
                        if (isUptownSelected) {
                            const selectedLocName = $('#uptownLocationSelect').val() || 'Uptown Charlotte';
                            $('#FoodDeliveryAddress').val('Uptown Pickup: ' + selectedLocName);
                        }
                        
                        document.querySelectorAll('.ala-carte-item').forEach(function(itemRow) {
                            const id = itemRow.getAttribute('data-id');
                            const qty = parseInt(itemRow.querySelector('.ala-carte-qty').value) || 0;
                            if (qty > 0) {
                                cartContainer.innerHTML += `<input type="hidden" name="AlaCarteQuantities[${id}]" value="${qty}" />`;
                            }
                        });
                        
                        // Reveal section and smoothly scroll to it
                        $(completeOrderSection).slideDown(400, function() {
                            completeOrderSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            populateSavedFoodCustomerDetails();
                            const emailEl = document.getElementById('FoodCustomerEmail');
                            if (emailEl) {
                                if (!emailEl.value) {
                                    emailEl.focus();
                                } else {
                                    const phoneEl = document.getElementById('FoodPhoneNumber');
                                    if (phoneEl && !phoneEl.value) phoneEl.focus();
                                }
                            }
                        });
                    });
                }
                
                recalculateTotals(); // Initial calculation
            });
            </text>
        }

    </script>
}
