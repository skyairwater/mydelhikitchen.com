@{
    ViewData["Title"] = "Contact";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary"><i class="bi bi-chat-dots me-2" style="color: var(--accent-color);"></i>Contact Delhi Kitchen</h1>
        <p class="lead text-muted">Get in touch for orders, catering, or grocery inquiries in Charlotte, NC.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border p-4 mb-4 rounded-4">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: var(--primary-color);">
                        <i class="bi bi-telephone-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-primary">Call or Text</h5>
                        <p class="text-muted mb-0">313.398.0524 / 980.370.1091</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: var(--primary-color);">
                        <i class="bi bi-envelope-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-primary">Email Us</h5>
                        <p class="text-muted mb-0">mydelhikitchen.healthy@gmail.com</p>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: var(--accent-color);">
                        <i class="bi bi-geo-alt-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-primary">Location</h5>
                        <p class="text-muted mb-0">Serving the greater Charlotte, NC metropolitan area.</p>
                    </div>
                </div>
            </div>

            <div class="alert border rounded-3 text-center" style="background-color: var(--hover-color); border-color: var(--border-color) !important; color: var(--text-color);">
                <i class="bi bi-shield-check me-2 text-primary"></i><strong>Zelle Payments:</strong> We accept Zelle to Pinki Basra at <strong>980.370.1091</strong>
            </div>
        </div>
    </div>
</div>