@{
    ViewData["Title"] = "Home";
}

<style>
    :root {
        --gold: #d7b56d;
        --text: var(--text-color, #212529);
    }
    
    .wrap {
        text-align: center;
        padding-top: 3vh;
        position: relative;
        z-index: 10;
    }

    /* 3D Box Carousel for Hero Logos */
    .logo-wrap {
        margin: 0 auto 1.5rem;
        max-width: 850px;
        padding: 0 15px;
        perspective: 1200px;
    }

    .cube-container {
        position: relative;
        width: 100%;
        max-height: 520px;
        aspect-ratio: 16 / 9;
        margin: 0 auto;
        transform-style: preserve-3d;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1.2s ease, transform 1.2s ease;
        overflow: hidden;
    }

    .show .cube-container {
        opacity: 1;
        transform: translateY(0);
    }

    .cube-face {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background-color: var(--card-bg, #ffffff);
        border-radius: 12px;
        backface-visibility: hidden;
        will-change: transform, opacity;
        transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1), opacity 1s cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* Title */
    .title {
        margin: 0;
        font-size: clamp(26px, 3.5vw, 48px);
        color: var(--text);
        font-weight: 400;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(22px);
        filter: blur(6px);
        transition: opacity 1.2s ease, transform 1.2s ease, filter 1.2s ease, letter-spacing 1.6s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    /* Rainbow Animated Heading */
    .rainbow-text {
        letter-spacing: 0.05em;
        background: linear-gradient(
            90deg,
            #ff2a2a,
            #ff7300,
            #ffc800,
            #10b981,
            #06b6d4,
            #3b82f6,
            #8b5cf6,
            #ec4899,
            #ff2a2a
        );
        background-size: 300% 100%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: rainbowShine 6s linear infinite;
        display: inline-block;
        font-weight: 700;
        filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.12));
    }

    @@keyframes rainbowShine {
        0% {
            background-position: 0% 50%;
        }
        100% {
            background-position: 300% 50%;
        }
    }

    /* Heading Flag Container & Animated Flag SVGs */
    .heading-flag-wrap {
        display: inline-block;
        position: relative;
        width: clamp(28px, 3.2vw, 44px);
        height: clamp(19px, 2.2vw, 29px);
        flex-shrink: 0;
        letter-spacing: normal;
        vertical-align: middle;
    }

    .hero-flag {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 4px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.22);
        transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero-flag-active {
        opacity: 1;
        transform: scale(1) translateY(0);
        pointer-events: auto;
    }

    .hero-flag-hidden {
        opacity: 0;
        transform: scale(0.65) translateY(6px);
        pointer-events: none;
    }

    /* Underline stroke */
    .rule {
        width: 0;
        height: 1px;
        margin: 14px auto 0;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        opacity: 0;
        transition: width 1.2s ease, opacity 1.2s ease;
        max-width: 380px;
    }

    /* Tagline */
    .tagline {
        margin: 14px 0 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: clamp(14px, 1.3vw, 18px);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--primary-color);
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 1s ease, transform 1s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .heart-emoji {
        display: inline-block;
        font-size: 1.15em;
        animation: heartPulse 1.8s ease-in-out infinite;
        filter: drop-shadow(0 2px 6px rgba(220, 38, 38, 0.4));
    }

    @@keyframes heartPulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.25);
        }
    }

    /* Activated state */
    .show .title {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        letter-spacing: 0.05em;
    }

    .show .rule {
        width: min(50vw, 380px);
        opacity: 1;
        transition-delay: 0.35s;
    }

    .show .tagline {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.75s;
    }

    /* Gentle “candle glow” shimmer */
    .glow {
        position: absolute;
        width: min(90vw, 750px);
        height: min(90vw, 750px);
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(215,181,109,0.14), transparent 60%);
        filter: blur(10px);
        animation: drift 6s ease-in-out infinite;
        pointer-events: none;
        opacity: 0.7;
    }

    @@keyframes drift {
        0%, 100% {
            transform: translate(-50%, -50%) translate(-10px, -8px) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) translate(14px, 10px) scale(1.03);
        }
    }

    /* Decorative container to prevent overflow */
    .hero-decor-wrap {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding-bottom: 2rem;
    }

    /* Respect reduced motion */
    @@media (prefers-reduced-motion: reduce) {
        .title, .rule, .tagline, .glow, .cube-container, .cube-face {
            animation: none !important;
            transition: none !important;
        }

        .title, .tagline, .cube-container {
            opacity: 1;
            transform: none;
            filter: none;
        }

        .rule {
            width: min(50vw, 380px);
            opacity: 1;
        }
    }
</style>

<div class="hero-decor-wrap">
    <div class="glow" aria-hidden="true"></div>

    <div class="wrap" id="wrap">
        <div class="logo-wrap">
            <div class="cube-container" id="heroCube" title="Click to transition image">
                <img src="~/images/MyDelhiKitchenIndia.png" alt="My Delhi Kitchen India" class="cube-face" id="cubeFace1" asp-append-version="true" style="opacity: 1; transform: translate(0, 0); z-index: 2;" />
                <img src="~/images/MyDelhiKitchenUptown.png" alt="My Delhi Kitchen Uptown" class="cube-face" id="cubeFace2" asp-append-version="true" style="opacity: 0; transform: translateY(100%) rotateX(-90deg); z-index: 1;" />
            </div>
        </div>
        <h1 class="title">
            <span class="rainbow-text">Delhi Kitchen</span>
            <span class="heading-flag-wrap" id="headingFlagWrap" aria-hidden="true">
                <!-- India Flag SVG (Displayed when MyDelhiKitchenIndia.png is visible) -->
                <svg id="heroFlagIndia" class="hero-flag hero-flag-active rounded" viewBox="0 0 900 600" aria-label="India Flag">
                    <rect width="900" height="200" fill="#FF9933"/>
                    <rect width="900" height="200" y="200" fill="#FFFFFF"/>
                    <rect width="900" height="200" y="400" fill="#138808"/>
                    <!-- Ashoka Chakra -->
                    <circle cx="450" cy="300" r="80" fill="none" stroke="#000080" stroke-width="8"/>
                    <circle cx="450" cy="300" r="16" fill="#000080"/>
                    <path d="M450,220v160 M410,225l80,150 M375,240l150,120 M350,265l200,70 M338,300h224 M350,335l200,-70 M375,360l150,-120 M410,375l80,-150 M490,225l-80,150 M525,240l-150,120 M550,265l-200,70 M550,335l-200,-70" stroke="#000080" stroke-width="3"/>
                </svg>
                <!-- American Flag SVG (Displayed when MyDelhiKitchenUptown.png is visible) -->
                <svg id="heroFlagUS" class="hero-flag hero-flag-hidden rounded" viewBox="0 0 7410 3900" aria-label="US Flag">
                    <rect width="7410" height="3900" fill="#b22234"/>
                    <path d="M0,450H7410M0,1050H7410M0,1650H7410M0,2250H7410M0,2850H7410M0,3450H7410" stroke="#fff" stroke-width="300"/>
                    <rect width="2964" height="2100" fill="#3c3b6e"/>
                    <g fill="#fff">
                        <g id="s18_hero">
                            <g id="s9_hero">
                                <g id="s5_hero">
                                    <g id="s4_hero">
                                        <path id="s_hero" d="M247,90 317,307 134,173H360L177,307z"/>
                                        <use href="#s_hero" y="420"/>
                                        <use href="#s_hero" y="840"/>
                                        <use href="#s_hero" y="1260"/>
                                    </g>
                                    <use href="#s_hero" y="1680"/>
                                </g>
                                <use href="#s4_hero" x="247" y="210"/>
                            </g>
                            <use href="#s9_hero" x="494"/>
                        </g>
                        <use href="#s18_hero" x="988"/>
                        <use href="#s9_hero" x="1976"/>
                        <use href="#s5_hero" x="2470"/>
                    </g>
                </svg>
            </span>
        </h1>
        <div class="rule"></div>
        <p class="tagline">Cloud Kitchen <span class="heart-emoji">❤️</span> Since 2026</p>
    </div>
</div>

<script>
    window.addEventListener("load", () => {
      // reveal animation
      setTimeout(() => document.getElementById("wrap").classList.add("show"), 120);

      const face1 = document.getElementById("cubeFace1");
      const face2 = document.getElementById("cubeFace2");
      const flagIndia = document.getElementById("heroFlagIndia");
      const flagUS = document.getElementById("heroFlagUS");
      const heroCube = document.getElementById("heroCube");

      let currentFace = 1; // 1 = India, 2 = Uptown
      let isAnimating = false;

      // Varied cinematic 3D animations that rotate sequentially
      const transitions = [
          {
              // 1. Horizontal 3D Cube Flip (Right to Left)
              outStyle: "translateX(-100%) rotateY(-90deg)",
              inStart: "translateX(100%) rotateY(90deg)"
          },
          {
              // 2. Vertical 3D Cube Flip (Bottom to Top)
              outStyle: "translateY(-100%) rotateX(90deg)",
              inStart: "translateY(100%) rotateX(-90deg)"
          },
          {
              // 3. 3D Card / Perspective Spin
              outStyle: "rotateY(180deg) scale(0.85)",
              inStart: "rotateY(-180deg) scale(0.85)"
          },
          {
              // 4. Horizontal 3D Cube Flip (Left to Right)
              outStyle: "translateX(100%) rotateY(90deg)",
              inStart: "translateX(-100%) rotateY(-90deg)"
          },
          {
              // 5. Cinematic Depth Zoom & Subtle Angle Twist
              outStyle: "scale(1.2) rotate(3deg)",
              inStart: "scale(0.8) rotate(-3deg)"
          },
          {
              // 6. Vertical 3D Cube Flip (Top to Bottom)
              outStyle: "translateY(100%) rotateX(-90deg)",
              inStart: "translateY(-100%) rotateX(90deg)"
          },
          {
              // 7. Diagonal 3D Origami Fold
              outStyle: "translate(-25%, -25%) rotate3d(1, 1, 0, 65deg) scale(0.88)",
              inStart: "translate(25%, 25%) rotate3d(1, 1, 0, -65deg) scale(0.88)"
          }
      ];

      let transitionIndex = 0;

      function triggerFlip() {
          if (isAnimating) return;
          isAnimating = true;

          const currentEl = currentFace === 1 ? face1 : face2;
          const nextEl = currentFace === 1 ? face2 : face1;
          const nextFace = currentFace === 1 ? 2 : 1;

          const t = transitions[transitionIndex];
          transitionIndex = (transitionIndex + 1) % transitions.length;

          // Prepare incoming element in starting position without animation
          nextEl.style.transition = "none";
          nextEl.style.transform = t.inStart;
          nextEl.style.opacity = "0";
          nextEl.style.zIndex = "2";

          // Force reflow
          void nextEl.offsetWidth;

          // Smoothly animate both elements simultaneously
          const animTiming = "transform 1s cubic-bezier(0.65, 0, 0.35, 1), opacity 1s cubic-bezier(0.65, 0, 0.35, 1)";
          currentEl.style.transition = animTiming;
          nextEl.style.transition = animTiming;

          currentEl.style.transform = t.outStyle;
          currentEl.style.opacity = "0";
          currentEl.style.zIndex = "1";

          nextEl.style.transform = "translate(0, 0) rotate(0deg) rotateX(0deg) rotateY(0deg) scale(1)";
          nextEl.style.opacity = "1";

          // Synchronize the flag next to Delhi Kitchen heading
          if (flagIndia && flagUS) {
              if (nextFace === 1) {
                  // India active -> India flag
                  flagUS.classList.remove("hero-flag-active");
                  flagUS.classList.add("hero-flag-hidden");
                  flagIndia.classList.remove("hero-flag-hidden");
                  flagIndia.classList.add("hero-flag-active");
              } else {
                  // Uptown active -> American flag
                  flagIndia.classList.remove("hero-flag-active");
                  flagIndia.classList.add("hero-flag-hidden");
                  flagUS.classList.remove("hero-flag-hidden");
                  flagUS.classList.add("hero-flag-active");
              }
          }

          currentFace = nextFace;

          setTimeout(() => {
              isAnimating = false;
          }, 1050);
      }

      // Automatically change every 4 seconds
      let intervalId = setInterval(triggerFlip, 4000);

      // Also allow clicking the image to immediately trigger the next dynamic animation
      if (heroCube) {
          heroCube.style.cursor = "pointer";
          heroCube.addEventListener("click", () => {
              clearInterval(intervalId);
              triggerFlip();
              intervalId = setInterval(triggerFlip, 4000);
          });
      }
    });
</script>


<div class="container-fluid px-0">
    <div class="container py-4">
        <div class="row text-center mb-4">
            <div class="col-12">
                <h2 class="fw-bold" style="color: var(--text-color);">Pure Vegetarian, Healthy, Freshly Prepared Food Delivered to Your Doorstep in Charlotte</h2>                
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-shop mb-3" style="font-size: 2.5rem; color: var(--primary-color);"></i>
                    <h3 class="h5 fw-bold text-primary">Indian Groceries</h3>
                    <p class="small text-muted mb-0">Wide range of Indian spices, dals, rice, and fresh groceries at prices lower than retail stores, delivered directly to your home.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-egg-fried mb-3" style="font-size: 2.5rem; color: var(--accent-color);"></i>
                    <h3 class="h5 fw-bold" style="color: var(--text-color);">Fresh Indian Food</h3>
                    <p class="small text-muted mb-0">Authentic, piping hot North Indian lunches and dinner meals prepared fresh with premium quality ingredients.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-truck mb-3" style="font-size: 2.5rem; color: var(--primary-color);"></i>
                    <h3 class="h5 fw-bold text-primary">Catering Services</h3>
                    <p class="small text-muted mb-0">Customized, reliable Indian catering for birthdays, poojas, parties, and corporate gatherings across Charlotte, NC.</p>
                </div>
            </div>
        </div>
    </div>
</div>