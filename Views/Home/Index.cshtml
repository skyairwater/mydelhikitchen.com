@{
    ViewData["Title"] = "Home";
}

<style>
    :root {
        --gold: #d7b56d;
        --text: var(--text-color, #212529);
    }
    
    .wrap {
        text-align: center;
        padding-top: 3vh;
        position: relative;
        z-index: 10;
    }

    /* Responsive Logo */
    .logo-wrap {
        margin: 0 auto 1.5rem;
        max-width: 850px;
        padding: 0 15px;
    }

    .hero-logo {
        max-width: 100%;
        height: auto;
        max-height: 520px;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1.2s ease, transform 1.2s ease;
    }

    .show .hero-logo {
        opacity: 1;
        transform: translateY(0);
    }

    /* Title */
    .title {
        margin: 0;
        font-size: clamp(26px, 3.5vw, 48px);
        color: var(--text);
        font-weight: 400;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(22px);
        filter: blur(6px);
        transition: opacity 1.2s ease, transform 1.2s ease, filter 1.2s ease, letter-spacing 1.6s ease;
    }

    /* Underline stroke */
    .rule {
        width: 0;
        height: 1px;
        margin: 14px auto 0;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        opacity: 0;
        transition: width 1.2s ease, opacity 1.2s ease;
        max-width: 380px;
    }

    /* Small tagline (optional but elegant) */
    .tagline {
        margin: 12px 0 0;
        font-family: Arial, sans-serif;
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--primary-color, blue);
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 1s ease, transform 1s ease;
    }

    /* Activated state */
    .show .title {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        letter-spacing: 0.2em;
    }

    .show .rule {
        width: min(50vw, 380px);
        opacity: 1;
        transition-delay: 0.35s;
    }

    .show .tagline {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.75s;
    }

    /* Gentle “candle glow” shimmer */
    .glow {
        position: absolute;
        width: min(90vw, 750px);
        height: min(90vw, 750px);
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(215,181,109,0.14), transparent 60%);
        filter: blur(10px);
        animation: drift 6s ease-in-out infinite;
        pointer-events: none;
        opacity: 0.7;
    }

    @@keyframes drift {
        0%, 100% {
            transform: translate(-50%, -50%) translate(-10px, -8px) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) translate(14px, 10px) scale(1.03);
        }
    }

    /* Decorative container to prevent overflow */
    .hero-decor-wrap {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding-bottom: 2rem;
    }

    /* Respect reduced motion */
    @@media (prefers-reduced-motion: reduce) {
        .title, .rule, .tagline, .glow, .hero-logo {
            animation: none !important;
            transition: none !important;
        }

        .title, .tagline, .hero-logo {
            opacity: 1;
            transform: none;
            filter: none;
        }

        .rule {
            width: min(50vw, 380px);
            opacity: 1;
        }
    }
</style>

<div class="hero-decor-wrap">
    <div class="glow" aria-hidden="true"></div>

    <div class="wrap" id="wrap">
        <div class="logo-wrap">
            <img src="~/images/MyDelhiKitchenlogv1.png" alt="My Delhi Kitchen Logo" class="img-fluid hero-logo" asp-append-version="true" />
        </div>
        <h1 class="title">Delhi Kitchen</h1>
        <div class="rule"></div>
        <p class="tagline">Cloud Kitchen • Since 2026</p>
    </div>
</div>

<script>
    window.addEventListener("load", () => {
      // small delay makes it feel more "premium"
      setTimeout(() => document.getElementById("wrap").classList.add("show"), 120);
    });
</script>


<div class="container-fluid px-0">
    
    <div class="container py-5">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="fw-bold">Pure Vegetarian, Healthy, Freshly prepared food delivered to your door step in Charlotte</h2>                
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <i class="bi bi-shop text-primary mb-3" style="font-size: 2.5rem;"></i>
                    <h3 class="h5 fw-bold">Indian Groceries</h3>
                    <p class="small text-muted">Wide range of Indian spices, dals, rice, and frozen snacks at prices less than retail stores, delivered free to your house.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <i class="bi bi-egg-fried text-warning mb-3" style="font-size: 2.5rem;"></i>
                    <h3 class="h5 fw-bold">Fresh Indian Food</h3>
                    <p class="small text-muted">Delicious North Indian meals prepared fresh with high-quality ingredients.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <i class="bi bi-truck text-success mb-3" style="font-size: 2.5rem;"></i>
                    <h3 class="h5 fw-bold">Catering Services</h3>
                    <p class="small text-muted">Reliable Indian food catering for parties and events across Charlotte.</p>
                </div>
            </div>
        </div>
    </div>
</div>