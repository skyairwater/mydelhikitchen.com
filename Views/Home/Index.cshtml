@{
    ViewData["Title"] = "Home";
}

<style>
    :root {
        --gold: #d7b56d;
        --text: var(--text-color, #212529);
    }
    
    .wrap {
        text-align: center;
        padding-top: 3vh;
        position: relative;
        z-index: 10;
    }

    /* 3D Box Carousel for Hero Logos */
    .logo-wrap {
        margin: 0 auto 1.5rem;
        max-width: 850px;
        padding: 0 15px;
        perspective: 1200px;
    }

    .cube-container {
        position: relative;
        width: 100%;
        max-height: 520px;
        aspect-ratio: 16 / 9;
        margin: 0 auto;
        transform-style: preserve-3d;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1.2s ease, transform 1.2s ease;
        overflow: hidden;
    }

    .show .cube-container {
        opacity: 1;
        transform: translateY(0);
    }

    .cube-face {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background-color: var(--card-bg, #ffffff);
        border-radius: 12px;
        backface-visibility: hidden;
        transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1), opacity 1s cubic-bezier(0.65, 0, 0.35, 1);
    }

    /* Face states: Front (Visible), Out (Rotate up like a box), In (Waiting below) */
    .cube-face.face-active {
        transform: translateY(0) rotateX(0deg);
        opacity: 1;
        z-index: 2;
    }

    .cube-face.face-hidden-top {
        transform: translateY(-100%) rotateX(90deg);
        opacity: 0;
        z-index: 1;
    }

    .cube-face.face-hidden-bottom {
        transform: translateY(100%) rotateX(-90deg);
        opacity: 0;
        z-index: 1;
    }

    /* Title */
    .title {
        margin: 0;
        font-size: clamp(26px, 3.5vw, 48px);
        color: var(--text);
        font-weight: 400;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(22px);
        filter: blur(6px);
        transition: opacity 1.2s ease, transform 1.2s ease, filter 1.2s ease, letter-spacing 1.6s ease;
    }

    /* Underline stroke */
    .rule {
        width: 0;
        height: 1px;
        margin: 14px auto 0;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        opacity: 0;
        transition: width 1.2s ease, opacity 1.2s ease;
        max-width: 380px;
    }

    /* Small tagline (optional but elegant) */
    .tagline {
        margin: 12px 0 0;
        font-family: Arial, sans-serif;
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--primary-color, blue);
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 1s ease, transform 1s ease;
    }

    /* Activated state */
    .show .title {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
        letter-spacing: 0.2em;
    }

    .show .rule {
        width: min(50vw, 380px);
        opacity: 1;
        transition-delay: 0.35s;
    }

    .show .tagline {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.75s;
    }

    /* Gentle “candle glow” shimmer */
    .glow {
        position: absolute;
        width: min(90vw, 750px);
        height: min(90vw, 750px);
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: radial-gradient(circle, rgba(215,181,109,0.14), transparent 60%);
        filter: blur(10px);
        animation: drift 6s ease-in-out infinite;
        pointer-events: none;
        opacity: 0.7;
    }

    @@keyframes drift {
        0%, 100% {
            transform: translate(-50%, -50%) translate(-10px, -8px) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) translate(14px, 10px) scale(1.03);
        }
    }

    /* Decorative container to prevent overflow */
    .hero-decor-wrap {
        position: relative;
        overflow: hidden;
        width: 100%;
        padding-bottom: 2rem;
    }

    /* Respect reduced motion */
    @@media (prefers-reduced-motion: reduce) {
        .title, .rule, .tagline, .glow, .cube-container, .cube-face {
            animation: none !important;
            transition: none !important;
        }

        .title, .tagline, .cube-container {
            opacity: 1;
            transform: none;
            filter: none;
        }

        .rule {
            width: min(50vw, 380px);
            opacity: 1;
        }
    }
</style>

<div class="hero-decor-wrap">
    <div class="glow" aria-hidden="true"></div>

    <div class="wrap" id="wrap">
        <div class="logo-wrap">
            <div class="cube-container" id="heroCube">
                <img src="~/images/MyDelhiKitchenIndia.png" alt="My Delhi Kitchen India" class="cube-face face-active" id="cubeFace1" asp-append-version="true" />
                <img src="~/images/MyDelhiKitchenUptown.png" alt="My Delhi Kitchen Uptown" class="cube-face face-hidden-bottom" id="cubeFace2" asp-append-version="true" />
            </div>
        </div>
        <h1 class="title">Delhi Kitchen</h1>
        <div class="rule"></div>
        <p class="tagline">Cloud Kitchen • Since 2026</p>
    </div>
</div>

<script>
    window.addEventListener("load", () => {
      // reveal animation
      setTimeout(() => document.getElementById("wrap").classList.add("show"), 120);

      // 3D Box continuous flip every 4 seconds
      const face1 = document.getElementById("cubeFace1");
      const face2 = document.getElementById("cubeFace2");
      let currentFace = 1;

      setInterval(() => {
          if (currentFace === 1) {
              // Face 1 rotates up and hides
              face1.classList.remove("face-active", "face-hidden-bottom");
              face1.classList.add("face-hidden-top");

              // Face 2 rotates up from bottom into front view
              face2.classList.remove("face-hidden-bottom", "face-hidden-top");
              face2.classList.add("face-active");

              // Prepare face 1 to come back from bottom on next turn
              setTimeout(() => {
                  face1.classList.remove("face-hidden-top");
                  face1.classList.add("face-hidden-bottom");
              }, 1000);

              currentFace = 2;
          } else {
              // Face 2 rotates up and hides
              face2.classList.remove("face-active", "face-hidden-bottom");
              face2.classList.add("face-hidden-top");

              // Face 1 rotates up from bottom into front view
              face1.classList.remove("face-hidden-bottom", "face-hidden-top");
              face1.classList.add("face-active");

              // Prepare face 2 to come back from bottom on next turn
              setTimeout(() => {
                  face2.classList.remove("face-hidden-top");
                  face2.classList.add("face-hidden-bottom");
              }, 1000);

              currentFace = 1;
          }
      }, 4000);
    });
</script>


<div class="container-fluid px-0">
    <div class="container py-4">
        <div class="row text-center mb-4">
            <div class="col-12">
                <h2 class="fw-bold" style="color: var(--text-color);">Pure Vegetarian, Healthy, Freshly Prepared Food Delivered to Your Doorstep in Charlotte</h2>                
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-shop mb-3" style="font-size: 2.5rem; color: var(--primary-color);"></i>
                    <h3 class="h5 fw-bold text-primary">Indian Groceries</h3>
                    <p class="small text-muted mb-0">Wide range of Indian spices, dals, rice, and fresh groceries at prices lower than retail stores, delivered directly to your home.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-egg-fried mb-3" style="font-size: 2.5rem; color: var(--accent-color);"></i>
                    <h3 class="h5 fw-bold" style="color: var(--text-color);">Fresh Indian Food</h3>
                    <p class="small text-muted mb-0">Authentic, piping hot North Indian lunches and dinner meals prepared fresh with premium quality ingredients.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border shadow-sm p-4 text-center rounded-4">
                    <i class="bi bi-truck mb-3" style="font-size: 2.5rem; color: var(--primary-color);"></i>
                    <h3 class="h5 fw-bold text-primary">Catering Services</h3>
                    <p class="small text-muted mb-0">Customized, reliable Indian catering for birthdays, poojas, parties, and corporate gatherings across Charlotte, NC.</p>
                </div>
            </div>
        </div>
    </div>
</div>