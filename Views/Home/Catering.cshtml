@{
    ViewData["Title"] = "Catering";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary"><i class="bi bi-truck me-2" style="color: var(--accent-color);"></i>Indian Food Catering Services</h1>
        <p class="lead text-muted">Make your events memorable with authentic, freshly prepared Indian catering in Charlotte, NC.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm p-4">
                <h3 class="h4 fw-bold mb-3 text-primary"><i class="bi bi-people-fill me-2" style="color: var(--accent-color);"></i>Parties & Events</h3>
                <p class="text-muted">From housewarmings to birthday parties, we provide customized menus that your guests will love.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm p-4">
                <h3 class="h4 fw-bold mb-3 text-primary"><i class="bi bi-briefcase-fill me-2" style="color: var(--accent-color);"></i>Corporate Catering</h3>
                <p class="text-muted">Professional catering solutions for office lunches, team meetings, and corporate gatherings.</p>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <div class="card shadow-sm p-4 rounded-4 border">
            <h4 class="fw-bold mb-2">Ready to plan your custom menu?</h4>
            <p class="text-muted mb-3">Call Pinki Basra at <strong class="text-primary">980.370.1091</strong> for custom quotes and party packages.</p>
            <div>
                <a asp-action="Contact" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">Contact Us</a>
            </div>
        </div>
    </div>
</div>