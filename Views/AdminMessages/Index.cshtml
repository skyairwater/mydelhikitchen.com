@model IEnumerable<EcommerceStore.Models.AppDynamicMessage>

@{
    ViewData["Title"] = "Manage Dynamic Messages";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-chat-left-text text-primary me-2"></i> Manage Dynamic Messages</h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle me-2"></i>Create New Message</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="px-4">Tag Name</th>
                            <th>Message Content</th>
                            <th>Last Updated</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary px-4">@item.Tag</td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 400px;" title="@item.Content">
                                            @if (string.IsNullOrEmpty(item.Content))
                                            {
                                                <span class="text-muted fst-italic">[Empty - Hidden from site]</span>
                                            }
                                            else
                                            {
                                                @* Use Regex or simple strip tags for display preview to avoid broken HTML formatting *@
                                                @Html.Raw(item.Content)
                                            }
                                        </div>
                                    </td>
                                    <td class="small text-muted">@item.LastUpdated.ToEstFormat()</td>
                                    <td class="text-end px-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete the message associated with \u0027@item.Tag\u0027?');" style="display:inline;">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle fs-4 mb-2 d-block"></i>
                                    No dynamic messages configured yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
